        "/ventas": {
            "get": {
                "tags": [
                    "Ventas"
                ],
                "summary": "Listar ventas del usuario autenticado",
                "operationId": "6e38629b739ddff528106d8c40a85313",
                "parameters": [
                    {
                        "name": "sucursal_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "estado",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "completada",
                                "pendiente",
                                "anulada"
                            ]
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista paginada de ventas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/Paginacion"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Venta"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Ventas"
                ],
                "summary": "Crear una venta con sus líneas de detalle",
                "description": "Crear una venta con sus detalles.\r\n\r\nBody JSON:\r\n{\r\n  \"cliente_id\"           : 1,           // requerido\r\n  \"sucursal_id\"          : 1,           // requerido\r\n  \"tipo_pago\"            : \"contado\",   // contado|credito\r\n  \"dias_credito\"         : 30,          // solo si tipo_pago=credito\r\n  \"descuento_porcentaje\" : 0,\r\n  \"observaciones\"        : \"\",\r\n  \"detalles\": [\r\n    {\r\n      \"producto_id\"         : 5,\r\n      \"cantidad\"            : 2,\r\n      \"precio_unitario\"     : 15.00,\r\n      \"descuento_porcentaje\": 0\r\n    }\r\n  ]\r\n}",
                "operationId": "7a926f6262af9bda6082ea3c4bef0ade",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "cliente_id",
                                    "sucursal_id",
                                    "tipo_pago",
                                    "detalles"
                                ],
                                "properties": {
                                    "cliente_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "sucursal_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "tipo_pago": {
                                        "type": "string",
                                        "example": "contado",
                                        "enum": [
                                            "contado",
                                            "credito"
                                        ]
                                    },
                                    "dias_credito": {
                                        "description": "Requerido si tipo_pago=credito",
                                        "type": "integer",
                                        "example": 30,
                                        "nullable": true
                                    },
                                    "descuento_porcentaje": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 0
                                    },
                                    "observaciones": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "detalles": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/components/schemas/DetalleVenta"
                                        },
                                        "minItems": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Venta creada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Venta"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Validación fallida",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Errores422"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
