                ]
            },
            "post": {
                "tags": [
                    "Pagos"
                ],
                "summary": "Registrar un pago sobre una venta",
                "operationId": "87903839d26c336b6cefeef217eb1850",
                "parameters": [
                    {
                        "name": "venta",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "monto",
                                    "metodo_pago"
                                ],
                                "properties": {
                                    "monto": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 100
                                    },
                                    "fecha_pago": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-06-01",
                                        "nullable": true
                                    },
                                    "metodo_pago": {
                                        "type": "string",
                                        "enum": [
                                            "efectivo",
                                            "transferencia",
                                            "tarjeta",
                                            "cheque"
                                        ]
                                    },
                                    "referencia": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "observaciones": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pago registrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "pago": {
                                            "$ref": "#/components/schemas/PagoVenta"
                                        },
                                        "saldo_pendiente": {
                                            "type": "number",
                                            "format": "float"
                                        },
                                        "estado": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Venta ya pagada o validación fallida",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
